# Lead / quote delivery (pick one — first match wins in code order)
# 1) Webhook (Zapier, Make, Slack incoming, custom CRM)
LEAD_WEBHOOK_URL=

# 2) Resend email (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@yourdomain.com
LEAD_FROM_EMAIL=quotes@yourdomain.com

# 3) Formspree (https://formspree.io)
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxx

# Newsletter / nurture (optional overrides; falls back to lead vars above)
NEWSLETTER_WEBHOOK_URL=
FORMSPREE_NEWSLETTER_ENDPOINT=

# If none of the above are set, /api/quote and /api/subscribe return a
# prefilled mailto: so submissions still work on Vercel with zero secrets.
